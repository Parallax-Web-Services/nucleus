{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parallax:nebula-cpanel:reviewed-host-profile:v2",
  "title": "Reviewed cPanel host profile; requires target-vendor inspection, not a default profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "helpers",
    "vendor_sources",
    "registration_notification",
    "outputs",
    "vendor_parents"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "app_id": {
      "const": "parallax_nebula"
    },
    "helpers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "register",
        "unregister",
        "registered",
        "install",
        "uninstall"
      ],
      "properties": {
        "register": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "unregister": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registered": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "install": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uninstall": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "vendor_sources": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 32,
      "required": [
        "/usr/local/cpanel/Cpanel/AppConfig/Register.pm",
        "/usr/local/cpanel/Cpanel/Plugin/Install.pm",
        "/usr/local/cpanel/Cpanel/Themes/Serializer/DynamicUI.pm"
      ],
      "propertyNames": {
        "pattern": "^/usr/local/cpanel/(?:(?:Cpanel|Whostmgr)/(?:[A-Za-z0-9_]+/)*[A-Za-z0-9_]+\\.pm|bin/sprite_generator|scripts/verify_api_spec_files|3rdparty/perl/536/cpanel-lib/File/Copy/Recursive\\.pm)$",
        "not": {
          "pattern": "[\\u0000-\\u0020\\u007f]"
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[a-f0-9]{64}$"
      },
      "description": "Pins reviewed public implementation sources in addition to the five helper entry points; no vendor source is bundled."
    },
    "registration_notification": {
      "const": true,
      "description": "The vendor sends a new-AppConfig registration notification. This fact and the CLI acknowledgement do not authorize installation or sending it."
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whm",
        "cpanel"
      ],
      "properties": {
        "whm": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "mode"
            ],
            "properties": {
              "path": {
                "const": "/var/cpanel/apps/parallax_nebula.conf"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "mode": {
                "enum": [
                  384,
                  420
                ]
              }
            }
          }
        },
        "cpanel": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "mode"
            ],
            "properties": {
              "path": {
                "type": "string",
                "anyOf": [
                  {
                    "pattern": "^/usr/local/cpanel/base/frontend/jupiter/(?:[a-zA-Z0-9_-]+/)*(?:dynamicui_)?parallax_nebula\\.(?:conf|svg|png)$"
                  },
                  {
                    "const": "/usr/local/cpanel/whostmgr/addonfeatures/parallax_nebula"
                  }
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "mode": {
                "enum": [
                  384,
                  420
                ]
              }
            }
          }
        }
      }
    },
    "vendor_parents": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "required": [
        "/usr/local/cpanel"
      ],
      "propertyNames": {
        "pattern": "^/usr/local/cpanel(?:/[A-Za-z0-9_.-]+)*$",
        "not": {
          "pattern": "(?:^|/)(?:parallax[-_]nebula|\\.\\.?)(?:/|$)"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uid",
          "gid",
          "mode"
        ],
        "properties": {
          "uid": {
            "const": 0
          },
          "gid": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095,
            "description": "Runtime also requires no group/other write bits (0022)."
          }
        }
      },
      "description": "Exact existing vendor-directory UID0/GID/mode pins; canonical root-owned directories without group/other write. Own plugin and portal directories retain strict root:root rules."
    }
  }
}
