use strict;use warnings;use Test::More;use FindBin;use File::Temp qw(tempdir);use File::Path qw(make_path remove_tree);use File::Find;use File::Copy qw(copy);use Digest::SHA qw(sha256_hex);use IPC::Open3;use Symbol qw(gensym);use Archive::Tar;
plan skip_all=>'Run isolated packaging fixtures as Linux root' unless $>==0;
my@roots;my$source="$FindBin::RealBin/..";
sub fixture {umask 0022;my$r=tempdir('nebula-cpanel-test-XXXXXXXX',DIR=>'/run',CLEANUP=>0);chmod 0755,$r;push@roots,$r;my$p="$r/pkg";make_path($p,{mode=>0755});find({no_chdir=>1,wanted=>sub{my$f=$File::Find::name;my$rel=substr($f,length($source));$rel=~s{^/}{};if($rel eq 'dist'){$File::Find::prune=1;return;}return if $rel eq '';die 'Unexpected source link' if -l$f;if(-d$f){make_path("$p/$rel",{mode=>0755});}elsif(-f$f){copy($f,"$p/$rel")or die$!;chmod((stat$f)[2]&0777,"$p/$rel");}}},$source);make_path("$p/dist",{mode=>0755});return($r,$p);}
sub run {my($p,$path)=@_;local$ENV{PATH}=$path//'/usr/bin:/bin';my$err=gensym;my$pid=open3(my$in,my$out,$err,'/bin/sh',"$p/scripts/package.sh");close$in;local$/;my$stdout=<$out>//'';my$stderr=<$err>//'';waitpid($pid,0);return($?>>8,$stdout,$stderr);}
{
 my($r,$p)=fixture();my($code)=run($p);is($code,0,'local development distribution builds');my$a="$p/dist/0.1.3-dev/nebula-cpanel-0.1.3-dev.tar.gz";ok(-f$a,'archive exists');open my$f,'<',$a;binmode$f;local$/;my$b=<$f>;close$f;my$sha=sha256_hex($b);open$f,'<',"$p/dist/0.1.3-dev/SHA256SUMS";is(<$f>,"$sha  nebula-cpanel-0.1.3-dev.tar.gz\n",'public archive checksum matches');close$f;my$tar=Archive::Tar->new($a,1);my@members=$tar->get_files;ok(@members>10,'archive contains reviewable source');ok(!(grep {$_->name=~m{(?:^/|(?:^|/)\.\.(?:/|$))} || !$_->is_file} @members),'archive has only normalized regular source members');my$prefix='nebula-cpanel-0.1.3-dev/';my$manifest=$tar->get_content($prefix.'SOURCE-SHA256SUMS');my$valid=1;for(split/\n/,$manifest){my($h,$file)=split/  /,$_,2;$valid=0 if !defined$file || sha256_hex($tar->get_content($prefix.$file)//'')ne$h;}ok($valid,'internal checksum manifest binds every included source');my$before=(stat$a)[1];my($again)=run($p);isnt($again,0,'existing distribution output refuses overwrite');is((stat$a)[1],$before,'existing archive inode preserved');
}
