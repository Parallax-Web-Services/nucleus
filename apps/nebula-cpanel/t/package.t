 my($r,$p)=fixture();make_path("$r/fake-bin");open my$f,'>',"$r/fake-bin/tar"or die$!;print{$f}"#!/bin/sh\nexit 42\n";close$f;chmod 0755,"$r/fake-bin/tar";my($code)=run($p,"$r/fake-bin:/usr/bin:/bin");isnt($code,0,'tar failure is not hidden by gzip');ok(!-e"$p/dist/0.1.3-dev/nebula-cpanel-0.1.3-dev.tar.gz" && !-e"$p/dist/0.1.3-dev/SHA256SUMS",'failed tar publishes neither archive nor checksum');my@left=glob("$p/dist/0.1.3-dev/.package-*");is(scalar@left,0,'only owned build temporary directory cleaned');
